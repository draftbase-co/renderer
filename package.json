{
  "name": "@draftbase/renderer",
  "version": "0.5.3",
  "description": "Framework-agnostic MDX renderer for Draftbase content (React, Next.js RSC, React Native, Astro, Vite, Vue)",
  "keywords": [
    "draftbase",
    "mdx",
    "cms",
    "react",
    "vue",
    "renderer",
    "astro",
    "vite"
  ],
  "license": "MIT",
  "author": "Draftbase",
  "homepage": "https://draftbase.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draftbase-co/renderer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./vue": "./dist/vue.js",
    "./react-native": "./dist/reactNative.js",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/generate-css-text.mjs && tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "lint": "node scripts/generate-css-text.mjs && tsc --noEmit",
    "test": "node --test dist/wrapperClassName.test.js dist/toHtml.test.js dist/compileMDX.test.js dist/reactNativeComponents.test.js dist/reactNative.test.js dist/MDXContent.test.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "hast-util-to-html": "^9.0.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "vue": "^3.5.0",
    "typescript": "^5.6.0"
  }
}
