{
  "name": "@draftbase/renderer",
  "version": "0.1.0",
  "description": "Framework-agnostic MDX renderer for Draftbase content (React, Next.js RSC, React Native)",
  "keywords": [
    "draftbase",
    "mdx",
    "cms",
    "react",
    "renderer"
  ],
  "license": "MIT",
  "author": "Draftbase",
  "homepage": "https://draftbase.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draftbase-co/draftbase-monorepo.git",
    "directory": "packages/renderer"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "lint": "tsc --noEmit",
    "test": "node --test dist/wrapperClassName.test.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@draftbase/tsconfig": "workspace:*",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
